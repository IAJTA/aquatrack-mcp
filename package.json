{
  "name": "aquatrack-mcp",
  "version": "1.0.0",
  "description": "MCP server for AquaTrack - IoT water-consumption monitoring.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aquatrack-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:env": "node --env-file .env dist/index.js",
    "dev": "tsx watch --env-file .env src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
