# Port to listen on
PORT=3000

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# AquaTrack REST API.
AQUATRACK_URL=https://api.aquatrack.net

PUBLIC_URL=https://your-deployment-host

OAUTH_ENABLED=true

# Optional
MCP_EVAL_TOKEN=<el_token_generado_en_paso_1>
AQUATRACK_SERVICE_EMAIL=tu-cuenta-de-servicio@ejemplo.com
AQUATRACK_SERVICE_PASSWORD=tu-contraseña